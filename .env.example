# agent_workbench 环境变量示例
# 复制为 .env 后按需填写；不填 CHAT_MODEL / EMBEDDING_MODEL 时自动使用确定性替身。

# 运行环境：dev | test | prod
APP_ENV=dev

# LLM / Embedding（留空或使用 test 环境时启用替身）
CHAT_MODEL=
EMBEDDING_MODEL=

# 真实 API（OpenAI 兼容；填了 CHAT_MODEL 才需要）
# API Key：日志与错误信息中绝不打印
API_KEY=
# Base URL：中转/网关地址；留空走官方端点
BASE_URL=
# Embedding 可选用独立凭据；留空则回退上面的 API_KEY / BASE_URL
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=

# 服务
HOST=127.0.0.1
PORT=8000

# 日志级别
LOG_LEVEL=INFO

# LangSmith 追踪开关（默认关闭，关闭时应用完全本地可运行）
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
